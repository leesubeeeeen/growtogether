{
  "hosting": {
    "public": "build/web",
    "ignore": ["**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api{,/**}", "function": "api" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
        ]
      }
    ]
  },
  "functions": { "source": "functions", "runtime": "nodejs20" }
}
